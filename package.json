{
  "name": "cse341",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": {
    "name": "Mario Brino",
    "email": "mariobrino@gmail.com"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:local\" \"npm run dev:openapi\"",
    "dev:local": "tsx --env-file .env --watch src/server.ts",
    "dev:openapi": "nodemon -x tsx --env-file .env src/openapi.ts --watch src --ext ts",
    "prebuild": "tsx src/openapi.ts",
    "build": "tsc --project tsconfig.build.json",
    "postbuild": "tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "preview": "NODE_ENV=production node --env-file .env dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretypecheck": "npm run prebuild",
    "typecheck": "tsc --noEmit",
    "cli": "tsx --env-file .env src/cli/index.cli.ts"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.18",
    "express": "^5.2.1",
    "mongoose": "^9.9.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/commander": "^2.12.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "commander": "^15.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "prettier-plugin-organize-imports": "^4.3.0",
    "swagger-autogen": "^2.23.7",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
